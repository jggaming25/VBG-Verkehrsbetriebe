# ===== Discord Bot (Developer Portal: https://discord.com/developers/applications) =====
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=

# ===== Dashboard / Login =====
# In Prod: deine Render-URL, z.B. https://vbg-ticket-bot.onrender.com
# In Dev: http://localhost:10000
WEB_URL=http://localhost:10000
SESSION_SECRET=
PORT=10000

# ===== Optional (empfohlen) =====
# Server-ID, um Slash-Commands nur in einem Server zu registrieren (sonst global, dauert bis ~1h)
GUILD_ID=
# Rolle mit Dashboard-Zugriff (Admin ist immer erlaubt)
ADMIN_ROLE_ID=1544006176109498458

# ===== Datenverzeichnis (Transkripte + DB) =====
DATA_DIR=./data