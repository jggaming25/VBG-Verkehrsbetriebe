# ===== Discord Bot (Developer Portal: https://discord.com/developers/applications) =====
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=

# ===== Dashboard / Login =====
# Produktion: deine Render-URL, z.B. https://vbg-ticket-bot-ijeq.onrender.com (OHNE / am Ende)
# Dev: http://localhost:10000
WEB_URL=https://vbg-ticket-bot-ijeq.onrender.com
SESSION_SECRET=
PORT=10000

# ===== Optional (empfohlen) =====
# Server-ID fuer sofortige Slash-Registrierung (sonst global, dauert bis ~1h)
GUILD_ID=
# Rolle mit Dashboard-Zugriff (Administrator ist immer erlaubt)
ADMIN_ROLE_ID=1544006176109498458

# ===== Datenverzeichnis (DB + Transkripte) =====
DATA_DIR=./data

# ===== Optionale API-Keys fuer Zusatzmodule =====
# Fuers /removebg Command (kostenloser Key unter https://www.remove.bg/api)
REMOVEBG_API_KEY=
# Fuers Twitch-Modul (Apps unter https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=